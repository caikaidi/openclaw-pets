{
  "name": "@openclaw-pets/plugin",
  "version": "0.5.2",
  "description": "OpenClaw Pets backend, state projection, and additive context plugin",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caikaidi/openclaw-pets.git",
    "directory": "packages/openclaw-plugin"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "openclaw.plugin.json",
    "README.md"
  ],
  "scripts": {
    "build": "corepack pnpm --filter @openclaw-pets/protocol build && tsup src/index.ts --format esm --clean --external openclaw",
    "lint": "eslint src test --max-warnings=0",
    "pack:check": "npm pack --dry-run",
    "test": "corepack pnpm --filter @openclaw-pets/protocol build && vitest run",
    "typecheck": "corepack pnpm --filter @openclaw-pets/protocol build && tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@openclaw-pets/protocol": "workspace:*",
    "openclaw": "2026.8.1-beta.2",
    "tsup": "8.5.0"
  },
  "peerDependencies": {
    "openclaw": ">=2026.8.1-beta.2"
  },
  "openclaw": {
    "extensions": [
      "./dist/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.8.1-beta.2",
      "minGatewayVersion": ">=2026.8.1-beta.2"
    },
    "build": {
      "openclawVersion": "2026.8.1-beta.2",
      "pluginSdkVersion": "2026.8.1-beta.2"
    }
  }
}
